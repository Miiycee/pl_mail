<div class="px-4 py-4 space-y-4">
    <p class="text-sm text-ink-muted">{{ 'mail_notification.intro'|trans }}</p>
    <form method="post" action="{{ path('app_settings_mail_notifications_save') }}" class="space-y-4">
        <input type="hidden" name="_token" value="{{ csrf_token('mail_notification_settings') }}">
        <label class="flex items-center gap-2 text-sm text-ink">
            <input type="checkbox" name="enabled" value="1" {% if mailNotification.enabled %}checked{% endif %}>
            {{ 'mail_notification.enabled'|trans }}
        </label>
        <div class="rounded-xl border border-line p-3 space-y-3">
            <label class="flex items-center gap-2 text-sm text-ink">
                <input type="checkbox" name="webhook_enabled" value="1" {% if mailNotification.webhook_enabled %}checked{% endif %}>
                {{ 'mail_notification.webhook_enabled'|trans }}
            </label>
            <label class="block text-sm text-ink">{{ 'mail_notification.webhook_url'|trans }}
                <input class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2 text-sm" type="url" name="webhook_url" value="{{ mailNotification.webhook_url }}" placeholder="https://message-nest.example/webhook">
            </label>
            <p class="text-xs text-ink-muted">{{ 'mail_notification.webhook_help'|trans }}</p>
        </div>
        <div class="rounded-xl border border-line p-3 space-y-3">
            <label class="flex items-center gap-2 text-sm text-ink">
                <input type="checkbox" name="telegram_enabled" value="1" {% if mailNotification.telegram_enabled %}checked{% endif %}>
                {{ 'mail_notification.telegram_enabled'|trans }}
            </label>
            <label class="block text-sm text-ink">{{ 'mail_notification.telegram_token'|trans }}
                <input class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2 text-sm" type="password" name="telegram_token" autocomplete="new-password" placeholder="{% if mailNotification.telegram_token_set %}{{ 'mail_notification.telegram_token_saved'|trans }}{% else %}123456:ABC…{% endif %}">
            </label>
            <label class="block text-sm text-ink">{{ 'mail_notification.telegram_chat_id'|trans }}
                <input class="mt-1 w-full rounded-lg border border-line bg-canvas px-3 py-2 text-sm" type="text" name="telegram_chat_id" value="{{ mailNotification.telegram_chat_id }}" placeholder="{{ 'mail_notification.telegram_chat_id_placeholder'|trans }}">
            </label>
            <p class="text-xs text-ink-muted">{{ 'mail_notification.telegram_help'|trans }}</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <button class="inline-flex items-center rounded-lg bg-accent px-4 py-2 text-sm font-medium text-accent-ink" type="submit">{{ 'mail_notification.save'|trans }}</button>
        </div>
    </form>
    <form method="post" action="{{ path('app_settings_mail_notifications_test') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('mail_notification_settings') }}">
        <button class="inline-flex items-center rounded-lg border border-line px-4 py-2 text-sm font-medium text-ink" type="submit">{{ 'mail_notification.test'|trans }}</button>
    </form>
</div>
